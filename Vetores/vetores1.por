programa
{
	
	funcao inicio()
	{
		cadeia frutas[5] = {"Banana", "Maçã", "Jaca", "Mexerica", "Kiwi"}

		para( inteiro posicao = 0; posicao <= 4; posicao++ ) {
			escreva(frutas[posicao])
		}
	}
}
