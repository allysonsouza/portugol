programa
{
	
	funcao inicio()
	{
		inteiro numeroMaximo
		inteiro contador = 1

		escreva("Insira um número maior que 1: \n")
		leia(numeroMaximo)

		enquanto( contador <= numeroMaximo ) {
			escreva( contador )
		}
	}
}
