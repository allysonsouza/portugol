programa
{
	
	funcao inicio()
	{
		inteiro temperatura

		escreva("Digite a temperatura")
		leia(temperatura)

		se(temperatura <= 16){
			escreva("Está frio")
		} senao se(temperatura < 25) {
			escreva("Está um clima tranquilo")
		} senao {
			escreva("Está fazendo calooor!")
		}
		
	}
}
