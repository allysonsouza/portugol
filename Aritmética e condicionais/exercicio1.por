programa
{
	
	funcao inicio()
	{
		inteiro numero1
		inteiro numero2
		inteiro soma, subtracao, multiplicacao, divisao


		escreva("Digite o primeiro número:")
		leia(numero1)

		escreva("Digite o segundo número: ")
		leia(numero2)

		soma = numero1 + numero2
		escreva("Resultado da soma:")
		escreva(soma)

		subtracao = numero1 - numero2
		escreva("Resultado da subtração\n")
		escreva(subtracao)

		multiplicacao = numero1 * numero2
		escreva("Resultado da multiplicação")
		escreva(multiplicacao)

		divisao = numero1 / numero2
		escreva("Resultado da divisão")
		escreva(divisao)
		
	}
}
