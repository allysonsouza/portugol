programa
{
	
	funcao inicio()
	{
		real comprimento
		real largura
		real area

		escreva("Insira o comprimento do cômodo")
		leia(comprimento)

		escreva("Insira a largura do cômodo")
		leia(largura)

		area = comprimento * largura

		escreva("A área do cômodo é: " + area + "m²")
	}
}
