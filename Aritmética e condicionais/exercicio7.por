programa
{
	
	funcao inicio()
	{
		inteiro numero

		escreva("Insira um número")
		leia(numero)

		se(numero > 0){
			escreva("O número é positivo!")
		} senao se(numero == 0) {
			escreva("O número é zero") 
		} senao {
			escreva("O número é negativo")
		}






		se(numero > 0){
			escreva("Positivo")
		}senao {
			se(numero <0){
				escreva("Negativo")
			} senao {
				escreva("O número é 0")
			}
		}


		se(numero > 0){
			escreva("Positivo")
		}

		se(numero < 0){
			escreva("Negativo")
		}

		escreva("É zero")










		
	}
}
